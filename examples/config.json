{
  "label": "Example setup",
  "trust": "shared",
  "pub": {
    "mcp": [
      {
        "name": "github",
        "enabled": true,
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "envKeys": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
        "description": "GitHub repo / issue / PR tools"
      },
      {
        "name": "filesystem",
        "enabled": true,
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/me/workspace"],
        "envKeys": []
      }
    ],
    "models": [
      {
        "provider": "provider-text",
        "id": "text-model",
        "alias": "text",
        "maxTokens": 128000,
        "modelType": "text",
        "parameters": {
          "temperature": 0.2,
          "topP": 0.95
        }
      },
      {
        "provider": "provider-multimodal",
        "id": "multimodal-model",
        "alias": "vision",
        "contextWindow": 200000,
        "maxOutputTokens": 8192,
        "modelType": "multimodal",
        "parameters": {
          "reasoningEffort": "medium"
        }
      },
      {
        "provider": "provider-image",
        "id": "image-model",
        "alias": "image",
        "modelType": "image-generation",
        "generationModes": ["text-to-image", "image-to-image"],
        "parameters": {
          "size": "1024x1024",
          "quality": "high"
        }
      },
      {
        "provider": "provider-video",
        "id": "video-model",
        "alias": "video",
        "modelType": "video-generation",
        "generationModes": ["text-to-video", "image-to-video"],
        "parameters": {
          "durationSeconds": 8,
          "aspectRatio": "16:9"
        }
      }
    ],
    "skills": [
      { "id": "docx", "enabled": true, "order": 1 },
      { "id": "pdf", "enabled": true, "order": 2 }
    ],
    "prompts": [
      { "id": "code-review", "title": "Code Review" }
    ],
    "agents": [],
    "resources": []
  },
  "secret": {
    "endpoints": {
      "provider-text": "https://api.example.com/text",
      "provider-multimodal": "https://api.example.com/multimodal",
      "provider-image": "https://api.example.com/images",
      "provider-video": "https://api.example.com/videos"
    },
    "customPrompts": {
      "code-review": "Review this code for bugs, security issues, and style.",
      "default": "You are a senior engineer. Be concise."
    },
    "providerHints": [
      { "provider": "provider-multimodal", "baseUrl": "https://api.example.com/v1" }
    ]
  }
}
