{
  "label": "Personal backup (synthetic credentials)",
  "trust": "self",
  "pub": {
    "mcp": [
      {
        "name": "github",
        "enabled": true,
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "envKeys": ["GITHUB_PERSONAL_ACCESS_TOKEN"]
      }
    ],
    "models": [
      {
        "provider": "provider-a",
        "id": "model-x",
        "alias": "x",
        "contextWindow": 128000,
        "modelType": "multimodal",
        "parameters": { "reasoningEffort": "medium" }
      }
    ],
    "skills": [],
    "prompts": []
  },
  "secret": {
    "endpoints": { "provider-a": "https://api.example.com" },
    "customPrompts": {},
    "providerHints": [],
    "secrets": {
      "provider-a": { "apiKey": "EXAMPLE_ONLY_PROVIDER_KEY" },
      "github": {
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "EXAMPLE_ONLY_GITHUB_TOKEN"
        }
      }
    }
  }
}
