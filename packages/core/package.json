{
  "name": "@agentconfig/core",
  "version": "0.1.0",
  "description": "AgentConfig Bundle core: schema, codec, encryption helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "keywords": ["agentconfig", "mcp", "ai", "config", "bundle", "portable", "encrypted"],
  "author": "Zhuah Dong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/agentconfig.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2"
  }
}
