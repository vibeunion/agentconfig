{
  "name": "@agentconfig/cli",
  "version": "0.1.0",
  "description": "AgentConfig Bundle CLI: validate / encode / decode bundles.",
  "type": "module",
  "bin": {
    "agentconfig": "./dist/index.js"
  },
  "files": ["dist"],
  "keywords": ["agentconfig", "mcp", "ai", "config", "cli", "bundle"],
  "author": "Zhuah Dong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/agentconfig.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "dependencies": {
    "@agentconfig/core": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
